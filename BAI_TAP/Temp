package BAI_TAP;
import java.util.Scanner;
import java.time.LocalDate;

class SACH {
    public String maSach;
    public String tenSach;
    public String loaiSach;
    public String tacGia;
    public int namXuatBan;
    public double donGia;
    public int soluong;
    SACH ds[];
    int n;

    public void NHAP (Scanner sc) {
        int hople;
        do {
            System.out.println("-----Nhap thong tin sach:-------");
            System.out.printf("Nhap ma sach: ");
            maSach = sc.nextLine();

            System.out.printf("Nhap ten sach: ");
            tenSach = sc.nextLine();

            System.out.printf("Nhap loai sach: ");
            loaiSach = sc.nextLine();

            System.out.printf("Nhap tac gia: ");
            tacGia = sc.nextLine();

            System.out.printf("Nhap nam xuat ban: ");
            namXuatBan = sc.nextInt();

            System.out.printf("Nhap don gia: ");
            donGia = sc.nextDouble();

            System.out.printf("Nhap so luong: ");
            soluong = sc.nextInt();
            sc.nextLine();

            hople = Kiemtrahople();

            if (hople == 0) {
                System.out.println("Thong tin sach khong hop le. Vui long nhap lai!");
            }
        } while (hople == 0);
    }

    public int Kiemtrahople() {
        int namhientai = LocalDate.now().getYear();
        int hople = 1;

        if (donGia <= 0 || donGia != (double)donGia) {
            System.out.println("Don gia khong hop le!");
            hople = 0;
        }

        if (soluong < 0 || soluong != (int)soluong) {
            System.out.println("So luong khong hop le!");
            hople = 0;
        }

        if (namXuatBan < 1900 || namXuatBan > namhientai || namXuatBan != (int)namXuatBan) {
            System.out.println("Nam xuat ban khong hop le!");
            hople = 0;
        }

        if (hople == 1) {
            System.out.println("Thong tin sach hop le.");
        }
        return hople;
    }

    public void Nhapdanhsach(Scanner sc) {
        do {
            System.out.printf("Nhap so luong sach: ");
            n = sc.nextInt();

            if (n <= 0 || n != (int)n) {
                System.out.println("So luong sach phai lon hon 0. Vui long nhap lai!");
            }
        } while (n <= 0);
        sc.nextLine();

        ds = new SACH[n+1];
        for (int i=1; i<=n; i++) {
            System.out.println("\nNhap thong tin sach thu " + i + ":");
            ds[i] = new SACH();
            ds[i].NHAP(sc);
        }
    }

    public double Thanhtien () {
        return donGia * soluong;
    }

    public double Phivanchuyen () {
        return 0.05*Thanhtien();
    }

    public double Tongtien () {
        return Thanhtien() + Phivanchuyen();
    }

    public void XUAT() {
        System.out.println("-----Thong tin sach:-------");
        System.out.println("Ma sach: " + maSach);
        System.out.println("Ten sach: " + tenSach);
        System.out.println("Loai sach: " + loaiSach);
        System.out.println("Tac gia: " + tacGia);
        System.out.println("Nam xuat ban: " + namXuatBan);
        System.out.println("Don gia: " + donGia);
        System.out.println("So luong: " + soluong);
    }

    public void Phanloaigia() {
        System.out.print("Phan loai gia sach: ");
        if (donGia < 50000) {
            System.out.println("Sach gia thap");
        } else if (donGia >= 50000 && donGia < 100000) {
            System.out.println("Sach gia trung binh");
        } else if (donGia >= 100000 && donGia < 200000) {
            System.out.println("Sach gia cao");
        } else {
            System.out.println("Sach gia dac biet");  
        }
    }

    public void Phanloaitonkho() {
        System.out.print("Phan loai ton kho: ");
        if (soluong == 0) {
            System.out.println("Het sach");
        } else if (soluong >= 1 && soluong <= 5) {
            System.out.println("Sap het");
        } else if (soluong > 6 && soluong <= 20) {
            System.out.println("Con it");
        } else {
            System.out.println("Con nhieu");
        }
    }

    public void Chonloaisach(Scanner sc) {
        int loaiSach;

        System.out.println("-----LOAI SACH-----");
        System.out.println("1. Sach giao khoa");
        System.out.println("2. Sach tham khao");
        System.out.println("3. Sach chuyen nganh");
        System.out.println("4. Sach khac");

        do {
            System.out.printf("Chon loai sach: ");
            loaiSach = sc.nextInt();

            if (loaiSach < 1 || loaiSach > 4 || loaiSach != (int)loaiSach) {
                System.out.println("Loai sach khong hop le. Vui long chon lai!");
            }
        } while (loaiSach < 1 || loaiSach > 4 || loaiSach != (int)loaiSach);

        switch (loaiSach) {
            case 1:
                System.out.println("Loai sach: Sach giao khoa");
                break;
            case 2:
                System.out.println("Loai sach: Sach tham khao");
                break;
            case 3:
                System.out.println("Loai sach: Sach chuyen nganh");
                break;
            case 4:
                System.out.println("Loai sach: Sach khac");
                break;
            default:
                System.out.println("Khong co loai sach nay!");
        }
    }

    public void TongSL_TongGT() {
        int tongSL = 0;
        double TongGT = 0;

        for (int i=1; i<=n; i++) {
            tongSL += ds[i].soluong;
            TongGT += ds[i].Tongtien();
        }

        System.out.println("\nTong so luong sach: " + tongSL);
        System.out.println("Tong gia tri sach: " + TongGT);
    }

    public void TIMSACH(Scanner sc) {
        sc.nextLine();
        System.out.printf("\nNhap ma sach can tim: ");
        String Masachcanatim = sc.nextLine();
        int flag = 0;

        for (int i=1; i<=n; i++) {
            if (ds[i].maSach.equals(Masachcanatim)) {
                System.out.println("Thong tin sach can tim: ");
                ds[i].XUAT();
                flag = 1;
                break;
            }
        }

        if (flag == 0) {
            System.out.println("Khong tim thay sach co ma " + Masachcanatim);
        }
    }

    public void menu(Scanner sc) {
        int chon;

        System.out.println("\n-----MENU-----");
        System.out.println("1. Nhap danh sach sach");
        System.out.println("2. Xuat danh sach sach");
        System.out.println("3. Tinh tong so luong va tong gia tri sach");
        System.out.println("4. Tim sach theo ma");
        System.out.println("5. Chon sach co loai sach (1. Sach giao khoa, 2. Sach tham khao, 3. Sach chuyen nganh, 4. Sach khac) trong thu vien");
        System.out.println("6. Phan loai gia sach");
        System.out.println("7. Phan loai ton kho");
        System.out.println("0. Thoat");

        System.out.printf("Chon chuc nang: ");
        chon = sc.nextInt();

        switch (chon) {
           case 1:
                Nhapdanhsach(sc);
                break;
            case 2:
                for (int i=1; i<=n; i++) {
                    System.out.println("\nThong tin sach thu " + i + ":");
                    ds[i].XUAT();
                }
                break;
            case 3:
                TongSL_TongGT();
                break;
            case 4:
                TIMSACH(sc);
                break;
            case 5:
                Chonloaisach(sc);
                break;
            case 6:
                for (int i=1; i<=n; i++) {
                    System.out.println("\nThong tin sach thu " + i + ":");
                    ds[i].Phanloaigia();
                }
                break;
            case 7:
                for (int i=1; i<=n; i++) {
                    System.out.println("\nThong tin sach thu " + i + ":");
                    ds[i].Phanloaitonkho();
                }
                break;
            case 0:
                System.out.println("Thoat chuong trinh.");
                System.exit(0);
            default:
                System.out.println("Chuc nang khong hop le. Vui long chon lai!");
        }
    }
}

public class QUANLITHUVIEN {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        SACH sach = new SACH();

        do {
            sach.menu(sc);
            System.out.printf("\nBan co muon tiep tuc ko ? (1. Co / 0. Khong): ");
            int tieptuc = sc.nextInt();
            sc.nextLine();
            if (tieptuc == 0) {
                break;
            }
        } while (true);
    }
}
